generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["backend_schema"]
}

enum SchemaStatus {
  Focus
  Active
  Finished
  Cancelled
  Paused

  @@schema("backend_schema")
}

model Schedule {
  id             String       @id @unique @default(uuid())
  name           String
  testDay        DateTime
  studyStartDate DateTime
  studyEndDate   DateTime
  status         SchemaStatus @default(Active)
  progress       String       @default("")
  days           Day[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  User           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?

  @@schema("backend_schema")
}

model Day {
  id         String   @id @default(uuid())
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String
  date       DateTime
  topics     Topic[]
  startTime  String
  endTime    String

  // evita dias duplicados por schedule
  @@unique([scheduleId, date])
  @@index([scheduleId])
  @@schema("backend_schema")
}

model Topic {
  id       String  @id @default(uuid())
  day      Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId    String
  name     String
  weight   Int
  duration Int // minutos
  status   Boolean @default(false)

  @@index([dayId])
  @@schema("backend_schema")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  password  String
  schedules Schedule[]
  avatar    String     @default("/profile.jpg")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@schema("backend_schema")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
  @@schema("backend_schema")
}
